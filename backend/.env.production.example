# ──────────────────────────────────────────────────────────────────
#  BebidaHub · Variables de entorno (producción)
#  Copia como `.env.production` y coloca valores reales.
# ──────────────────────────────────────────────────────────────────

DJANGO_SECRET_KEY=reemplaza-esto-por-una-clave-aleatoria-de-64-caracteres
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=bebidahub.example.com

# Dominio real del frontend publicado
CORS_ALLOWED_ORIGINS=https://bebidahub.example.com
CSRF_TRUSTED_ORIGINS=https://bebidahub.example.com

# Seguridad de transporte (usar tras un proxy/balanceador con TLS)
DJANGO_HSTS_SECONDS=31536000
DJANGO_SECURE_PROXY_SSL_HEADER=True

COCKTAIL_API_BASE_URL=https://www.thecocktaildb.com/api/json/v1/1
COCKTAIL_API_TIMEOUT=8
COCKTAIL_API_CACHE_TTL=300
