# ──────────────────────────────────────────────────────────────────
#  BebidaHub · Variables de entorno (desarrollo)
#  Copia este archivo como `.env` y genera una SECRET_KEY propia:
#    python -c "import secrets; print(secrets.token_urlsafe(64))"
# ──────────────────────────────────────────────────────────────────

# Clave secreta de Django. NUNCA la subas al repositorio.
DJANGO_SECRET_KEY=reemplaza-esto-por-una-clave-aleatoria-de-64-caracteres

# Entorno de ejecución: development | production
DJANGO_DEBUG=True

# Hosts permitidos (separados por coma)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Orígenes permitidos para el frontend (CORS, separados por coma)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Orígenes de confianza para CSRF (con esquema, separados por coma)
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Límite de cuerpos JSON/formulario (bytes) para evitar abusos de memoria
DJANGO_DATA_UPLOAD_MAX_MEMORY_SIZE=1048576
DJANGO_FILE_UPLOAD_MAX_MEMORY_SIZE=1048576

# ── API externa: TheCocktailDB (no requiere clave) ─────────────────
COCKTAIL_API_BASE_URL=https://www.thecocktaildb.com/api/json/v1/1
COCKTAIL_API_TIMEOUT=8
COCKTAIL_API_CACHE_TTL=300
